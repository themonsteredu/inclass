# --- 필수 환경 변수 ---

# Postgres 연결 문자열 (Vercel Postgres, Neon, Supabase 등)
DATABASE_URL="postgresql://user:password@host:5432/inclass?sslmode=require"

# NextAuth 세션 서명 키. `openssl rand -base64 32` 결과로 교체하세요.
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 배포 도메인 (Vercel은 자동 주입하는 VERCEL_URL 사용 가능). 개발 시에만 지정.
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob 읽기/쓰기 토큰 (Vercel 프로젝트의 Storage 탭에서 자동 주입)
BLOB_READ_WRITE_TOKEN=""
