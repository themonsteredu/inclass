# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- App ---
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-32chars-or-more
SETUP_TOKEN=change-me-only-used-for-first-admin-creation

# --- Bunny.net Stream ---
# Bunny dashboard → Stream → 라이브러리 선택 → API
BUNNY_LIBRARY_ID=YOUR_LIBRARY_ID
BUNNY_API_KEY=YOUR_API_KEY
# Bunny dashboard → Stream → 라이브러리 → Settings → Token Authentication 켜고 그 보안 키
BUNNY_TOKEN_AUTH_KEY=YOUR_TOKEN_AUTH_KEY
