# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- App ---
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-32chars-or-more
SETUP_TOKEN=change-me-only-used-for-first-admin-creation

# --- Vimeo ---
# https://developer.vimeo.com/apps → Create app → Generate Personal Access Token
# Required scopes: public, private
VIMEO_ACCESS_TOKEN=YOUR_VIMEO_PERSONAL_ACCESS_TOKEN
