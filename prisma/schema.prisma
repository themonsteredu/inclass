// Prisma schema for the lecture system (inclass)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role values:        "STUDENT" | "ADMIN"
// LectureType values: "TIP" | "CONCEPT" | "PATTERN"

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  name         String
  role         String       @default("STUDENT")
  createdAt    DateTime     @default(now())
  watchLogs    WatchLog[]
  enrollments  Enrollment[]
}

model Workbook {
  id          String       @id @default(cuid())
  title       String
  description String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  problems    Problem[]
  enrollments Enrollment[]
}

// 학생이 볼 수 있는 문제집을 제어합니다.
// (userId, workbookId) 쌍이 존재하면 학생은 해당 문제집과 하위 문제/강의 접근 가능.
model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  workbookId String
  grantedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  @@unique([userId, workbookId])
  @@index([userId])
  @@index([workbookId])
}

model Problem {
  id         String    @id @default(cuid())
  workbookId String
  number     Int
  title      String
  workbook   Workbook  @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  lectures   Lecture[]

  @@unique([workbookId, number])
  @@index([workbookId])
}

model Lecture {
  id         String      @id @default(cuid())
  problemId  String
  type       String      // TIP | CONCEPT | PATTERN
  title      String
  filePath   String      // Vercel Blob URL (절대 URL)
  mimeType   String      @default("video/mp4")
  sizeBytes  Int         @default(0)
  duration   Int         @default(0)
  createdAt  DateTime    @default(now())
  problem    Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  watchLogs  WatchLog[]

  @@unique([problemId, type])
  @@index([problemId])
}

model WatchLog {
  id              String   @id @default(cuid())
  userId          String
  lectureId       String
  watchedSeconds  Int      @default(0)
  lastPosition    Int      @default(0)
  completed       Boolean  @default(false)
  firstWatchedAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture         Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId])
  @@index([lectureId])
}
